{
  "name": "glance-readme-viewer",
  "version": "0.1.2",
  "description": "Glance — lightweight README viewer desktop app",
  "main": "main.js",
  "author": "NiranjanS8",
  "license": "MIT",
  "homepage": "https://github.com/NiranjanS8/glance-readme-viewer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiranjanS8/glance-readme-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/NiranjanS8/glance-readme-viewer/issues"
  },
  "keywords": [
    "electron",
    "markdown",
    "readme",
    "viewer",
    "desktop"
  ],
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish=never"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.10.0",
    "katex": "0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "11.12.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.glance.readme-viewer",
    "productName": "Glance",
    "files": [
      "!node_modules/**",
      "main.js",
      "preload.js",
      "renderer.js",
      "watcher.js",
      "folder.js",
      "theme-init.js",
      "index.html",
      "style.css",
      "HELP.md",
      "package.json",
      "node_modules/markdown-it/dist/**",
      "node_modules/markdown-it-anchor/dist/**",
      "node_modules/markdown-it-footnote/dist/markdown-it-footnote.min.js",
      "node_modules/markdown-it-emoji/dist/markdown-it-emoji.min.js",
      "node_modules/markdown-it-texmath/texmath.js",
      "node_modules/katex/dist/katex.min.js",
      "node_modules/katex/dist/katex.min.css",
      "node_modules/katex/dist/fonts/**/*",
      "node_modules/mermaid/dist/mermaid.min.js",
      "vendor/highlight.min.js",
      "vendor/fonts.css",
      "vendor/fonts/**/*",
      "node_modules/dompurify/dist/**",
      "node_modules/chokidar/**",
      "node_modules/readdirp/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
